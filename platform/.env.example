# VeQMS environment variables. Copy to .env for local runs outside Docker (npm run dev:api / dev:web).
# In Azure these come from the Bicep deployment and Key Vault; never commit real values.

# ---------- API (apps/api) ----------
NODE_ENV=development
PORT=8080
# Local: a login that is a member of veqms_app (see infra/local/initdb). Azure: the managed identity's name, no password.
DATABASE_URL=postgres://veqms_api:veqms_api_local_only@localhost:5432/veqms
DATABASE_ENTRA_AUTH=0
ENTRA_TENANT_ID=
ENTRA_API_AUDIENCE=
# Development persona sign-in (X-Dev-User). Refused when NODE_ENV=production.
DEV_AUTH=1
# Adobe Sign (docs/06-adobe-sign.md). mock | live
ADOBE_SIGN_MODE=mock
# oauth (OAuth app + refresh token) | integration-key (Enterprise integration key)
ADOBE_SIGN_AUTH=oauth
# The account's API address, e.g. https://api.eu1.adobesign.com/ (required for oauth)
ADOBE_SIGN_API_ACCESS_POINT=
# Base URI discovery for integration keys: https://api.adobesign.com, or https://api.adobesignsandbox.com for a sandbox
ADOBE_SIGN_DISCOVERY_URL=https://api.adobesign.com
ADOBE_SIGN_INTEGRATION_KEY=
ADOBE_SIGN_CLIENT_ID=
ADOBE_SIGN_CLIENT_SECRET=
ADOBE_SIGN_REFRESH_TOKEN=
# Webhooks: 32+ random characters in the webhook URL (/webhooks/adobe-sign/<token>); live mode only
ADOBE_SIGN_WEBHOOK_TOKEN=
# Expected X-AdobeSign-ClientId on webhooks (defaults to ADOBE_SIGN_CLIENT_ID)
ADOBE_SIGN_WEBHOOK_CLIENT_ID=
# azure | local
STORAGE_MODE=local
STORAGE_ACCOUNT_URL=
STORAGE_CONTAINER=records
LOCAL_STORAGE_DIR=./storage-local
SCIM_TOKEN=local-scim-token
# Shared QMS mailbox; empty = in-app notifications only
GRAPH_MAIL_FROM=
APP_BASE_URL=http://localhost:3000

# ---------- Web (apps/web) ----------
API_BASE_URL=http://localhost:8080
ENTRA_WEB_CLIENT_ID=
ENTRA_WEB_CLIENT_SECRET=
ENTRA_API_SCOPE=
# 32+ random bytes, base64. Generate with: openssl rand -base64 32
SESSION_SECRET=
