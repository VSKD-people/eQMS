{
  "name": "@veqms/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "VeQMS API: Entra ID auth, documents, DocuSign approvals, training records, reports",
  "main": "./dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "node --watch --experimental-strip-types src/server.ts",
    "start": "node dist/server.js",
    "test": "node --experimental-strip-types --test test/*.test.ts"
  },
  "dependencies": {
    "@azure/identity": "^4.5.0",
    "@azure/storage-blob": "^12.26.0",
    "@veqms/db": "*",
    "@veqms/domain": "*",
    "fastify": "^5.2.0",
    "jose": "^5.9.6",
    "pdf-lib": "^1.17.1",
    "zod": "^3.24.1"
  }
}
