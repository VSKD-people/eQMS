# VeQMS web app. Copy to .env.local for development. In Azure these come from Container Apps secrets / Key Vault.
# Internal address of the API (server-to-server only; the browser never calls it)
API_BASE_URL=http://localhost:8080
# Public address of this web app (used for the /auth/callback redirect URI)
APP_BASE_URL=http://localhost:3000
# Microsoft Entra ID: the web app registration (confidential client, authorisation code + PKCE)
ENTRA_TENANT_ID=
ENTRA_WEB_CLIENT_ID=
ENTRA_WEB_CLIENT_SECRET=
# Scope for the API app registration, e.g. api://<api-client-id>/access_as_user
ENTRA_API_SCOPE=
# 32+ random bytes, base64 (openssl rand -base64 32). Encrypts the session cookie.
SESSION_SECRET=
# 1 shows the demo persona picker instead of Microsoft sign-in. Never in production.
DEV_AUTH=1
