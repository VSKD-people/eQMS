# Secrets for docker-compose.pilot.yml. Copy to pilot.env (never commit it) and replace every value.
# Generate each with:  openssl rand -base64 36
DB_OWNER_PASSWORD=replace-me
APP_DB_PASSWORD=replace-me-at-least-24-characters
LOCAL_AUTH_SECRET=replace-me-at-least-32-characters
# 32 bytes, base64:  openssl rand -base64 32
SESSION_SECRET=replace-me
# The address people open. On a real host: its HTTPS address, and set VEQMS_LOCAL=0.
APP_BASE_URL=http://localhost:3001
