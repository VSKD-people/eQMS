{
  "name": "veqms-platform",
  "private": true,
  "version": "0.1.0",
  "description": "VeQMS electronic quality management system: full-stack platform (Phase 1)",
  "workspaces": ["packages/*", "apps/*"],
  "engines": { "node": ">=22.12" },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:migrate": "npm run migrate --workspace @veqms/db",
    "db:seed": "npm run seed --workspace @veqms/db",
    "db:test": "npm run test:sql --workspace @veqms/db",
    "dev:api": "npm run dev --workspace @veqms/api",
    "dev:web": "npm run dev --workspace @veqms/web"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.8.2"
  }
}
