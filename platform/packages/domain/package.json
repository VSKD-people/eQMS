{
  "name": "@veqms/domain",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared business rules for VeQMS: no runtime dependencies",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" } },
